# Copy to .env and source, or export these directly.
# Provide the HMAC secret as a literal value...
COCOON_HMAC_SECRET=change-me-to-at-least-16-random-bytes
# ...or point at a file containing it (set exactly one of the two).
# COCOON_HMAC_SECRET_FILE=/run/secrets/cocoon_hmac
COCOON_BIND=127.0.0.1:3000
COCOON_DB=cocoon.db
