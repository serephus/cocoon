# Copy to .env and source, or export these directly.

# --- Telegram bot (optional: the web/API work without it) ---

# Bot token (from @BotFather), or point at a file.
COCOON_TELEGRAM_BOT_TOKEN=
# COCOON_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/cocoon_bot_token

# Webhook secret: 16-256 chars of [A-Za-z0-9_-], or point at a file.
COCOON_TELEGRAM_WEBHOOK_SECRET=
# COCOON_TELEGRAM_WEBHOOK_SECRET_FILE=/run/secrets/cocoon_webhook_secret

# Public HTTPS base URL. The webhook is registered at
#   <COCOON_PUBLIC_URL><COCOON_TELEGRAM_WEBHOOK_PATH>/<secret>
COCOON_PUBLIC_URL=https://paste.example.com
COCOON_TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional.
# COCOON_TELEGRAM_REGISTER_WEBHOOK=true
# COCOON_TELEGRAM_PROXY=http://127.0.0.1:1080
# COCOON_TELEGRAM_API_URL=http://127.0.0.1:8081
# COCOON_MAX_SUBSCRIPTIONS=100

# --- HTTP ---
COCOON_BIND=127.0.0.1:3000
COCOON_DB=cocoon.db
